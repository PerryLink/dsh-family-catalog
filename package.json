{
  "name": "dsh-family-catalog",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Community Market standard catalog source for the PerryLink dsh-* plugin family.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build-catalog.mjs",
    "validate": "node scripts/validate.mjs",
    "check:counts": "node scripts/check-counts.mjs",
    "build:check": "node scripts/check-counts.mjs && node scripts/build-catalog.mjs && node scripts/validate.mjs",
    "check": "tsc -p tsconfig.check.json",
    "typecheck:ci": "tsc -p tsconfig.check.ci.json",
    "build:discovery": "node scripts/build-discovery.mjs",
    "build:facets": "node scripts/build-facets.mjs",
    "check:facets": "node scripts/check-facets.mjs",
    "bench": "node scripts/discovery-bench.mjs --source=index --fail-under=85",
    "search": "node scripts/search.mjs",
    "smoke:worker": "node scripts/worker-smoke.mjs",
    "smoke:mcp": "node scripts/mcp-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
